limit_req_zone $binary_remote_addr zone=groupmate_login:10m rate=5r/m;
server {
    listen 80 default_server;
    server_name PUBLIC_IP;
    location ^~ /.well-known/acme-challenge/ { root /var/www/groupmate-acme; default_type text/plain; }
    location / { return 308 https://PUBLIC_IP$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/groupmate-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/groupmate-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 29m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location = /api/login {
        limit_req zone=groupmate_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
